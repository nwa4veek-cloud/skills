# Copy to .env.local and replace these placeholders with your own project values.
# Never use the Supabase service-role key in client-side code.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional public contact number in international digits only. Configure the real number
# in the administrator dashboard before showing WhatsApp enquiry links.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional. Used for canonical metadata after a verified deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
